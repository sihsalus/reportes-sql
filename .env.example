# ── PostgreSQL (indicadores database) ────────────────────────────────────
INDICATORS_DB_HOST=localhost
INDICATORS_DB_PORT=5432
INDICATORS_DB_NAME=indicators
INDICATORS_DB_USER=postgres
INDICATORS_DB_PASSWORD=your_password

# ── MySQL (OpenMRS database) ─────────────────────────────────────────────
OPENMRS_DB_HOST=localhost
OPENMRS_DB_PORT=3306
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USER=root
OPENMRS_DB_PASSWORD=your_password

# Fail-fast MySQL pool timeouts (milliseconds). Prevent a slow/stuck
# OpenMRS database from saturating the pool and hanging the whole service.
# - CONNECT: TCP connect handshake ceiling (10s).
# - ACQUIRE: time waiting for a free pool connection (10s). mysql2 does not
#   expose acquireTimeout in PoolOptions; the application enforces it.
# - QUERY: per-query execution ceiling (30s). Increase only if your OpenMRS
#   dataset genuinely needs longer count queries.
OPENMRS_DB_CONNECT_TIMEOUT_MS=10000
OPENMRS_DB_ACQUIRE_TIMEOUT_MS=10000
OPENMRS_DB_QUERY_TIMEOUT_MS=30000

# ── OpenMRS REST API ─────────────────────────────────────────────────────
# The conceptos proxy calls OpenMRS with the calling user's session cookie, so
# no service credentials are configured here.
OPENMRS_API_URL=http://localhost/openmrs

# ── Application ──────────────────────────────────────────────────────────
PORT=8000

# Comma-separated list of allowed origins for CORS.
# Default (when empty): localhost:5173, localhost:8080 (and 127.0.0.1 equivalents).
# In production, set this to your gateway or SPA origin(s).
# CORS_ORIGINS=

# Register the official indicator catalog on startup (true|false).
# Each entry in src/catalog/indicators.json is verified and any missing
# indicator is registered (indicador + version 1), ready to calculate.
AUTO_REGISTER_CATALOG=true

# Nightly recalculation: the service recalculates a rolling window of months
# (current + previous ones) for every active indicator, once per day at the
# configured hour (America/Lima). On startup it also fills any month of the
# current year still missing results.
# Hour of the run (0-23, America/Lima) and window size in months.
# RECALC_HOUR=2
# RECALC_WINDOW_MONTHS=3   # legacy alias: RECALC_VENTANA_MESES

# ── Routing ──────────────────────────────────────────────────────────────
# Base path for running behind a reverse proxy / API gateway.
# Empty = all routes mount at root (standalone dev).
# Set it when integrating behind a gateway, e.g.:
#   BASE_PATH=/openmrs/services/reportes-sql
# When set, routes are prefixed (e.g. /openmrs/services/reportes-sql/indicadores)
# but /health remains available at root for gateway health checks.
BASE_PATH=
